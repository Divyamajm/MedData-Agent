# MedData AI Environment Configuration
# Optional: If you wish to enable enhanced LLM features, configure one of the keys below.
# The system operates 100% deterministically offline without any API key.

# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# API Service Authentication (Generate via: openssl rand -hex 32)
MEDDATA_API_KEY=
# Set to 'true' only for local interactive demo / Streamlit Cloud public demo mode
MEDDATA_ALLOW_UNAUTHENTICATED_DEMO=false

MEDDATA_ENV=development
DB_PATH=hospital_ultimate.db

